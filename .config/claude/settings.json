{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "fable",
  "statusLine": {
    "type": "command",
    "command": "~/.config/claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "marimo-pair@marimo-pair": true,
    "plannotator@plannotator": true
  },
  "extraKnownMarketplaces": {
    "marimo-pair": {
      "source": {
        "source": "github",
        "repo": "marimo-team/marimo-pair"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    }
  }
}
