font-family = "0xProto Nerd Font Mono"

# disable ligatures
# font-feature = -calt
# font-feature = -liga
# font-feature = -dlig

theme = Dark+

cursor-style = bar
cursor-style-blink = true

window-theme = ghostty

window-width = 120
window-height = 32
window-padding-x = 12
window-padding-y = 12

keybind = cmd+enter=unbind
keybind = shift+enter=text:\x0a

# linux-friendly navigation
keybind = ctrl+shift+o=new_split:right
keybind = ctrl+shift+e=new_split:down
